=1.5;fontFamily=Arial;fontSize=19;fontColor=#263747;fontStyle=0;spacing=8;" vertex="1" parent="c20"><mxGeometry as="geometry" x="300" y="107" width="180" height="66" /></mxCell><mxCell id="cruise" value="Cruise" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fillColor=#EAF1F8;strokeColor=#536879;strokeWidth=1.5;fontFamily=Arial;fontSize=19;fontColor=#263747;fontStyle=0;spacing=8;" vertex="1" parent="c20"><mxGeometry as="geometry" x="570" y="107" width="180" height="66" /></mxCell><mxCell id="takeoff" value="Take-off" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#536879;strokeWidth=1.5;fontFamily=Arial;fontSize=19;fontColor=#263747;fontStyle=0;spacing=8;" vertex="1" parent="c20"><mxGeometry as="geometry" x="840" y="107" width="180" height="66" /></mxCell><mxCell id="out" value="Transfer to pad" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#536879;strokeWidth=1.5;fontFamily=Arial;fontSize=19;fontColor=#263747;fontStyle=0;spacing=8;" vertex="1" parent="c20"><mxGeometry as="geometry" x="1110" y="107" width="180" height="66" /></mxCell><mxCell id="c22" value="" edge="1" parent="1" source="out" target="takeoff" style="edgeStyle=none;rounded=0;html=0;strokeColor=#536879;strokeWidth=1.6;endArrow=open;endFill=1;endSize=9;startArrow=none;startFill=1;startSize=10;dashed=0;dashPattern=6 5;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=1.0;entryY=0.5;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c23" value="departure slot&#10;/ occupy pad" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#263747;fontStyle=0;strokeColor=none;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="1330" y="612" width="110" height="46" /></mxCell><mxCell id="c24" value="" edge="1" parent="1" source="takeoff" target="cruise" style="edgeStyle=none;rounded=0;html=0;strokeColor=#536879;strokeWidth=1.6;endArrow=open;endFill=1;endSize=9;startArrow=none;startFill=1;startSize=10;dashed=0;dashPattern=6 5;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=1.0;entryY=0.5;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c25" value="departure complete&#10;/ release pad" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#263747;fontStyle=0;strokeColor=none;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="612" width="110" height="46" /></mxCell><mxCell id="c26" value="" edge="1" parent="1" source="cruise" target="land" style="edgeStyle=none;rounded=0;html=0;strokeColor=#536879;strokeWidth=1.6;endArrow=open;endFill=1;endSize=9;startArrow=none;startFill=1;startSize=10;dashed=0;dashPattern=6 5;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=1.0;entryY=0.5;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c27" value="arrival slot&#10;/ occupy pad" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#263747;fontStyle=0;strokeColor=none;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="790" y="612" width="110" height="46" /></mxCell><mxCell id="c28" value="" edge="1" parent="1" source="land" target="in" style="edgeStyle=none;rounded=0;html=0;strokeColor=#536879;strokeWidth=1.6;endArrow=open;endFill=1;endSize=9;startArrow=none;startFill=1;startSize=10;dashed=0;dashPattern=6 5;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=1.0;entryY=0.5;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c29" value="pad clear&#10;/ release pad" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#263747;fontStyle=0;strokeColor=none;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="520" y="612" width="110" height="46" /></mxCell><mxCell id="c30" value="" edge="1" parent="1" source="dispatch" target="out" style="edgeStyle=none;rounded=0;html=0;strokeColor=#536879;strokeWidth=1.6;endArrow=open;endFill=1;endSize=9;startArrow=none;startFill=1;startSize=10;dashed=0;dashPattern=6 5;exitX=0.5;exitY=1.0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="c31" value="plan committed and transfer due&#10;/ release origin stand" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=right;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#263747;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="1050" y="464" width="430" height="54" /></mxCell><mxCell id="c32" value="" edge="1" parent="1" source="in" target="unload" style="edgeStyle=none;rounded=0;html=0;strokeColor=#536879;strokeWidth=1.6;endArrow=open;endFill=1;endSize=9;startArrow=none;startFill=1;startSize=10;dashed=0;dashPattern=6 5;exitX=0.0;exitY=0.5;exitPerimeter=0;entryX=0.5;entryY=1.0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="170" y="695" /></Array></mxGeometry></mxCell><mxCell id="c33" value="destination stand reached&#10;/ occupy stand; update port" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#263747;fontStyle=0;strokeColor=none;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry as="geometry" x="52" y="487" width="230" height="62" /></mxCell><mxCell id="c34" value="Departure and arrival resources are reserved before leaving the origin stand; destination capacity is checked for arrival time." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#5E6C78;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="345" y="755" width="1300" height="27" /></mxCell><mxCell id="c35" value="Turnaround is sequential: unload → charge → board. Cruise is measured separately from take-off, landing and transfers.&#10;At the run horizon, include elapsed time in the current activity; aircraft are not forced to complete the cycle." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#5E6C78;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="845" width="1640" height="64" /></mxCell><mxCell id="c36" value="" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;strokeColor=#CFD7DF;strokeWidth=1.6;endArrow=none;endFill=1;endSize=9;startArrow=none;startFill=1;startSize=10;dashed=0;dashPattern=6 5;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="50" y="924" /><mxPoint as="targetPoint" x="1690" y="924" /></mxGeometry></mxCell><mxCell id="c37" value="Operational UML state diagram. These activity labels do not, by themselves, define a continuous-time Markov chain." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#5E6C78;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="935" width="1640" height="38" /></mxCell></root></mxGraphModel></diagram></mxfile>